# Copy to .env and adjust. `make up` reads it: compose interpolates these
# values into compose.yaml's `environment:` block, which forwards every
# knob here to the container explicitly (compose does not pass .env to
# containers by itself).

# Host port the stack is published on. If it's already taken, `make up`
# tells you before anything builds — pick another port here; the
# demo/admin URLs and the CORS origin allowlist follow it automatically.
CAIRN_PORT=8080

# Provider. `echo` is the deterministic stub (smoke tests, no model
# needed); set PROVIDER=ollama for real answers, with EMBEDDING_PROVIDER=
# ollama so retrieval uses real embeddings too. If Ollama runs on the
# host rather than the compose service, point OLLAMA_BASE_URL at
# http://host.docker.internal:11434.
PROVIDER=echo
EMBEDDING_PROVIDER=fake
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b-instruct
EMBEDDING_MODEL=nomic-embed-text

# Admin bootstrap (single admin account, Phase 5)
ADMIN_BOOTSTRAP_PASSWORD=

# Retrieval confidence (task 2.5). L2 distance, lower = closer; the default
# is a starting point, not validated — tune per corpus/embedding model with
# `make eval`'s correct-refusal-rate metric before trusting it in production.
RETRIEVAL_MAX_DISTANCE=1.2

# Limits. ORIGIN_ALLOWLIST left empty allows only the app's own origin
# (http://localhost:$CAIRN_PORT); set a comma-separated list of origins
# when embedding the widget on other sites.
ORIGIN_ALLOWLIST=
CHAT_MESSAGE_MAX_CHARS=500
RATE_LIMIT_IP_CAPACITY=20
RATE_LIMIT_IP_REFILL_PER_MINUTE=20
RATE_LIMIT_SESSION_CAPACITY=10
RATE_LIMIT_SESSION_REFILL_PER_MINUTE=10
