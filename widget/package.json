{
  "name": "cairn-widget",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --minify --outfile=dist/widget.js",
    "check-distribution": "node scripts/distribution.mjs check",
    "check-size": "node scripts/check-size.mjs",
    "sync-distribution": "node scripts/distribution.mjs sync",
    "test": "esbuild tests/protocol.test.ts --bundle --platform=node --format=esm --outfile=dist/protocol.test.mjs && node dist/protocol.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "5.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "brace-expansion": "2.1.4",
    "fast-uri": "3.1.6",
    "ip-address": "10.3.1",
    "js-yaml": "4.3.1",
    "lru-cache": "11.5.1",
    "tar": "7.5.21"
  }
}
